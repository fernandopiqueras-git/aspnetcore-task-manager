@using AspNetCoreTaskManager.Models
@model IReadOnlyCollection<TaskItem>
@{
    var projects = (IReadOnlyCollection<Project>)ViewBag.Projects;
    var tags = (IReadOnlyCollection<Tag>)ViewBag.Tags;
    var selectedTagIds = (int[])ViewBag.SelectedTagIds;
}
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Task Manager</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><main class="container">
<header><div><span class="eyebrow">ASP.NET Core MVC</span><h1>Task Manager</h1><p>Organiza proyectos, responsables y trabajo.</p></div><div class="header-actions"><a class="calendar-link" asp-controller="Calendar" asp-action="Index">Calendario</a><button type="button" class="primary" onclick="document.querySelector('#new-task').showModal()">Nueva tarea</button></div></header>
<section class="summary"><article><strong>@Model.Count(x => x.Status == WorkStatus.Pending)</strong><span>Pendientes</span></article><article><strong>@Model.Count(x => x.Status == WorkStatus.InProgress)</strong><span>En curso</span></article><article><strong>@Model.Count(x => x.Status == WorkStatus.Completed)</strong><span>Terminadas</span></article></section>
<section class="management"><form asp-action="AddProject" method="post"><input name="name" maxlength="80" placeholder="Nuevo proyecto" required /><button>Crear proyecto</button></form><form asp-action="AddTag" method="post"><input name="name" maxlength="40" placeholder="Nueva etiqueta" required /><button>Crear etiqueta</button></form></section>
<form method="get" class="filters"><input name="search" value="@ViewBag.Search" placeholder="Buscar tareas" /><select name="status"><option value="">Todos los estados</option>@foreach (var value in Enum.GetValues<WorkStatus>()) { <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString() ? "selected" : null)">@StatusText(value)</option> }</select><select name="priority"><option value="">Todas las prioridades</option>@foreach (var value in Enum.GetValues<TaskPriority>()) { <option value="@value" selected="@(ViewBag.Priority?.ToString() == value.ToString() ? "selected" : null)">@PriorityText(value)</option> }</select><button>Filtrar</button><a asp-action="Index">Limpiar</a></form>
<section class="board">
@foreach (var status in Enum.GetValues<WorkStatus>())
{
<div class="column"><h2>@StatusText(status)</h2>
@foreach (var item in Model.Where(x => x.Status == status))
{
<article class="task"><div class="task-top"><span class="priority @item.Priority.ToString().ToLowerInvariant()">@PriorityText(item.Priority)</span><time>@item.DueDate?.ToString("dd/MM/yyyy")</time></div>
<h3><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h3>
@if (item.Project is not null) { <span class="project">@item.Project.Name</span> }
@if (!string.IsNullOrWhiteSpace(item.AssignedTo)) { <p class="assigned">Responsable: @item.AssignedTo</p> }
<div class="tags">@foreach (var taskTag in item.TaskTags) { <span>@taskTag.Tag.Name</span> }</div>
<div class="actions"><form asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@item.Id" /><select name="status" onchange="this.form.submit()">@foreach (var value in Enum.GetValues<WorkStatus>()) { <option value="@value" selected="@(item.Status == value ? "selected" : null)">@StatusText(value)</option> }</select></form><a asp-action="Details" asp-route-id="@item.Id">Ver</a><a asp-action="Edit" asp-route-id="@item.Id">Editar</a><a asp-action="Delete" asp-route-id="@item.Id" class="danger">Eliminar</a></div></article>
}
</div>
}
</section></main>
<dialog id="new-task"><form asp-action="Create" method="post"><div class="dialog-header"><h2>Nueva tarea</h2><button type="button" onclick="this.closest('dialog').close()">×</button></div><div asp-validation-summary="All" class="validation"></div>
<label>Título<input name="Title" maxlength="100" required /></label><label>Descripción<textarea name="Description" maxlength="500"></textarea></label>
<label>Prioridad<select name="Priority">@foreach (var value in Enum.GetValues<TaskPriority>()) { <option value="@value" selected="@(value == TaskPriority.Medium ? "selected" : null)">@PriorityText(value)</option> }</select></label>
<label>Fecha límite<input type="date" name="DueDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
<label>Proyecto<select name="ProjectId"><option value="">Sin proyecto</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></label>
<label>Responsable<input name="AssignedTo" maxlength="100" /></label>
<fieldset><legend>Etiquetas</legend>@foreach (var tag in tags) { <label class="check"><input type="checkbox" name="tagIds" value="@tag.Id" checked="@(selectedTagIds.Contains(tag.Id) ? "checked" : null)" />@tag.Name</label> }</fieldset>
<div class="dialog-actions"><button type="button" onclick="this.closest('dialog').close()">Cancelar</button><button class="primary">Crear tarea</button></div></form></dialog>
@if (ViewData["OpenCreateDialog"] is true) { <script>document.querySelector("#new-task").showModal()</script> }
</body></html>
@functions {
private static string StatusText(WorkStatus value) => value switch { WorkStatus.Pending => "Pendiente", WorkStatus.InProgress => "En curso", WorkStatus.Completed => "Terminada", _ => value.ToString() };
private static string PriorityText(TaskPriority value) => value switch { TaskPriority.Low => "Baja", TaskPriority.Medium => "Media", TaskPriority.High => "Alta", _ => value.ToString() };
}
